# ==============================================================================
# Nebulo Share - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND BUILD VARIABLES (Cloudflare Pages / Vite Client)
# ------------------------------------------------------------------------------
# VITE_SERVER_URL: The full HTTPS URL of your deployed signaling backend.
# Leave empty for All-in-One deployment (same origin).
# Example for Option B (Cloudflare Pages + Render):
VITE_SERVER_URL="https://nebulo-share-backend.onrender.com"

# ------------------------------------------------------------------------------
# 2. BACKEND RUNTIME VARIABLES (Render Web Service / Node Server)
# ------------------------------------------------------------------------------
# PORT: Port for the Express HTTP & WebSocket server. (Auto-injected on Render).
PORT=3000

# NODE_ENV: Node environment ('development' | 'production').
NODE_ENV=production

# ALLOWED_ORIGINS: Comma-separated list of allowed origins or wildcards for CORS.
# Examples:
#   ALLOWED_ORIGINS="*"
#   ALLOWED_ORIGINS="https://nebulo-share.pages.dev,https://*.pages.dev"
ALLOWED_ORIGINS="*"

# KEEP_ALIVE: Set to 'true' to enable automated 12-minute heartbeat self-pings
# to keep free tier containers awake without hitting 15-minute idle timeouts.
KEEP_ALIVE=true

# RENDER_EXTERNAL_URL: Optional external URL for keep-alive self-ping target.
# Render automatically injects this on web services.
# RENDER_EXTERNAL_URL="https://nebulo-share-backend.onrender.com"

# LOCK_GRACE_MS: Grace period (in ms) to hold sender room locks during brief
# disconnects/reconnections before releasing (default: 45000).
LOCK_GRACE_MS=45000

# ------------------------------------------------------------------------------
# 3. OPTIONAL / LOCAL DEV & AI INTEGRATION
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Optional Gemini API key if using AI assistive features.
# GEMINI_API_KEY="your_api_key_here"
